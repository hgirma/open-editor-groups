{
  "name": "open-editor-groups",
  "displayName": "Open Editor Groups",
  "description": "Groups open editors by project (like the Visual Studio 2026 Tabs window) and colorizes them per project.",
  "version": "0.1.1",
  "publisher": "hgirma",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "open editors",
    "tabs",
    "group",
    "project",
    "solution",
    "csproj",
    "visual studio",
    "colorize"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openEditorGroups",
          "title": "Open Editors by Project",
          "icon": "resources/icons/activity.svg"
        }
      ]
    },
    "views": {
      "openEditorGroups": [
        {
          "id": "openEditorGroups.view",
          "name": "Open Editors by Project",
          "contextualTitle": "Open Editors by Project",
          "icon": "resources/icons/view.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openEditorGroups.view",
        "contents": "No editors are open."
      }
    ],
    "commands": [
      {
        "command": "openEditorGroups.open",
        "title": "Open",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.openToSide",
        "title": "Open to the Side",
        "category": "Open Editor Groups",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "openEditorGroups.close",
        "title": "Close",
        "category": "Open Editor Groups",
        "icon": "$(close)"
      },
      {
        "command": "openEditorGroups.closeOthers",
        "title": "Close Others in Project",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.closeSavedInProject",
        "title": "Close Saved in Project",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.closeProject",
        "title": "Close All in Project",
        "category": "Open Editor Groups",
        "icon": "$(close-all)"
      },
      {
        "command": "openEditorGroups.closeAll",
        "title": "Close All Editors",
        "category": "Open Editor Groups",
        "icon": "$(close-all)"
      },
      {
        "command": "openEditorGroups.closeSaved",
        "title": "Close Saved Editors",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.saveAll",
        "title": "Save All",
        "category": "Open Editor Groups",
        "icon": "$(save-all)"
      },
      {
        "command": "openEditorGroups.pin",
        "title": "Pin",
        "category": "Open Editor Groups",
        "icon": "$(pin)"
      },
      {
        "command": "openEditorGroups.unpin",
        "title": "Unpin",
        "category": "Open Editor Groups",
        "icon": "$(pinned)"
      },
      {
        "command": "openEditorGroups.revealInExplorer",
        "title": "Reveal in Explorer View",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.copyPath",
        "title": "Copy Path",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.openProjectFile",
        "title": "Open Project File",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.setProjectColor",
        "title": "Set Project Color...",
        "category": "Open Editor Groups",
        "icon": "$(symbol-color)"
      },
      {
        "command": "openEditorGroups.resetProjectColors",
        "title": "Reset Project Colors",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.refresh",
        "title": "Refresh",
        "category": "Open Editor Groups",
        "icon": "$(refresh)"
      },
      {
        "command": "openEditorGroups.sortAlphabetically",
        "title": "Sort Alphabetically",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.sortByEditorOrder",
        "title": "Sort by Editor Order",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.toggleColorizeTabs",
        "title": "Toggle Colorize Editor Tabs",
        "category": "Open Editor Groups"
      },
      {
        "command": "openEditorGroups.toggleFileIconStyle",
        "title": "Toggle File Icon Style (Color Bar / File Type)",
        "category": "Open Editor Groups"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "openEditorGroups.open", "when": "false" },
        { "command": "openEditorGroups.openToSide", "when": "false" },
        { "command": "openEditorGroups.close", "when": "false" },
        { "command": "openEditorGroups.closeOthers", "when": "false" },
        { "command": "openEditorGroups.closeSavedInProject", "when": "false" },
        { "command": "openEditorGroups.closeProject", "when": "false" },
        { "command": "openEditorGroups.pin", "when": "false" },
        { "command": "openEditorGroups.unpin", "when": "false" },
        { "command": "openEditorGroups.revealInExplorer", "when": "false" },
        { "command": "openEditorGroups.revealInOS", "when": "false" },
        { "command": "openEditorGroups.copyPath", "when": "false" },
        { "command": "openEditorGroups.copyRelativePath", "when": "false" },
        { "command": "openEditorGroups.openProjectFile", "when": "false" },
        { "command": "openEditorGroups.setProjectColor", "when": "false" }
      ],
      "view/title": [
        {
          "command": "openEditorGroups.saveAll",
          "when": "view == openEditorGroups.view",
          "group": "navigation@1"
        },
        {
          "command": "openEditorGroups.closeAll",
          "when": "view == openEditorGroups.view",
          "group": "navigation@2"
        },
        {
          "command": "openEditorGroups.closeSaved",
          "when": "view == openEditorGroups.view",
          "group": "1_close@1"
        },
        {
          "command": "openEditorGroups.sortAlphabetically",
          "when": "view == openEditorGroups.view && config.openEditorGroups.sortOrder != alphabetical",
          "group": "2_sort@1"
        },
        {
          "command": "openEditorGroups.sortByEditorOrder",
          "when": "view == openEditorGroups.view && config.openEditorGroups.sortOrder != editorOrder",
          "group": "2_sort@2"
        },
        {
          "command": "openEditorGroups.toggleFileIconStyle",
          "when": "view == openEditorGroups.view",
          "group": "3_color@1"
        },
        {
          "command": "openEditorGroups.toggleColorizeTabs",
          "when": "view == openEditorGroups.view",
          "group": "3_color@2"
        },
        {
          "command": "openEditorGroups.resetProjectColors",
          "when": "view == openEditorGroups.view",
          "group": "3_color@3"
        },
        {
          "command": "openEditorGroups.refresh",
          "when": "view == openEditorGroups.view",
          "group": "4_refresh@1"
        }
      ],
      "view/item/context": [
        {
          "command": "openEditorGroups.pin",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/ && viewItem =~ /:unpinned/",
          "group": "inline@1"
        },
        {
          "command": "openEditorGroups.unpin",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/ && viewItem =~ /:pinned/",
          "group": "inline@1"
        },
        {
          "command": "openEditorGroups.close",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/",
          "group": "inline@2"
        },
        {
          "command": "openEditorGroups.openToSide",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:file/",
          "group": "1_open@1"
        },
        {
          "command": "openEditorGroups.revealInExplorer",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:file/",
          "group": "1_open@2"
        },
        {
          "command": "openEditorGroups.revealInOS",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:file/ && viewItem =~ /:local/",
          "group": "1_open@3"
        },
        {
          "command": "openEditorGroups.copyPath",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:file/",
          "group": "2_copy@1"
        },
        {
          "command": "openEditorGroups.copyRelativePath",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:file/",
          "group": "2_copy@2"
        },
        {
          "command": "openEditorGroups.pin",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/ && viewItem =~ /:unpinned/",
          "group": "3_pin@1"
        },
        {
          "command": "openEditorGroups.unpin",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/ && viewItem =~ /:pinned/",
          "group": "3_pin@1"
        },
        {
          "command": "openEditorGroups.close",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/",
          "group": "4_close@1"
        },
        {
          "command": "openEditorGroups.closeOthers",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/",
          "group": "4_close@2"
        },
        {
          "command": "openEditorGroups.closeSavedInProject",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/",
          "group": "4_close@3"
        },
        {
          "command": "openEditorGroups.closeProject",
          "when": "view == openEditorGroups.view && viewItem =~ /^tab:/",
          "group": "4_close@4"
        },
        {
          "command": "openEditorGroups.closeProject",
          "when": "view == openEditorGroups.view && viewItem =~ /^project:/",
          "group": "inline@2"
        },
        {
          "command": "openEditorGroups.setProjectColor",
          "when": "view == openEditorGroups.view && viewItem =~ /^project:/ && viewItem =~ /:colorable/",
          "group": "1_project@1"
        },
        {
          "command": "openEditorGroups.openProjectFile",
          "when": "view == openEditorGroups.view && viewItem =~ /^project:/ && viewItem =~ /:hasFile/",
          "group": "1_project@2"
        },
        {
          "command": "openEditorGroups.closeSavedInProject",
          "when": "view == openEditorGroups.view && viewItem =~ /^project:/",
          "group": "4_close@1"
        },
        {
          "command": "openEditorGroups.closeProject",
          "when": "view == openEditorGroups.view && viewItem =~ /^project:/",
          "group": "4_close@2"
        }
      ]
    },
    "configuration": {
      "title": "Open Editor Groups",
      "properties": {
        "openEditorGroups.projectFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.csproj",
            "*.fsproj",
            "*.vbproj",
            "*.vcxproj",
            "*.esproj",
            "*.sqlproj",
            "*.wapproj",
            "*.shproj",
            "*.pyproj",
            "*.njsproj",
            "package.json",
            "Cargo.toml",
            "go.mod",
            "pyproject.toml",
            "pom.xml",
            "build.gradle",
            "build.gradle.kts"
          ],
          "markdownDescription": "File name patterns that identify a project root. An open editor is grouped under the nearest enclosing folder that contains a matching file. Patterns support `*` and `?` and are matched case-insensitively against file names. Earlier patterns win when a folder contains several matches."
        },
        "openEditorGroups.sortOrder": {
          "type": "string",
          "enum": [
            "alphabetical",
            "editorOrder"
          ],
          "enumDescriptions": [
            "Sort files within a project alphabetically (case-insensitive, like Visual Studio).",
            "Show files in the order of their tabs in the editor area."
          ],
          "default": "alphabetical",
          "description": "How files are ordered inside each project. Pinned editors are always listed first."
        },
        "openEditorGroups.pathStyle": {
          "type": "string",
          "enum": [
            "relativeToProject",
            "relativeToWorkspace",
            "none"
          ],
          "enumDescriptions": [
            "Show the folder path relative to the project folder (empty for files directly in the project folder).",
            "Show the folder path relative to the workspace folder, like the built-in Open Editors view.",
            "Do not show a path (closest to the Visual Studio look)."
          ],
          "default": "relativeToProject",
          "description": "Which path, if any, is shown next to each file name."
        },
        "openEditorGroups.fileIconStyle": {
          "type": "string",
          "enum": [
            "projectColorBar",
            "fileType"
          ],
          "enumDescriptions": [
            "Show a colored bar in the project's color, like Visual Studio 2026.",
            "Show the file-type icon from the current file icon theme."
          ],
          "default": "projectColorBar",
          "description": "Icon shown in front of each open editor."
        },
        "openEditorGroups.groupByEditorGroup": {
          "type": "boolean",
          "default": true,
          "description": "When the editor area is split into several editor groups, add a top-level node per editor group (Group 1, Group 2, ...). With a single editor group this has no effect."
        },
        "openEditorGroups.showNonFileEditors": {
          "type": "boolean",
          "default": true,
          "description": "Also list editors that are not backed by a file (Settings, Welcome, webviews, terminals in the editor area, ...) under an 'Other' node."
        },
        "openEditorGroups.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Select and reveal the active editor in the view when it changes."
        },
        "openEditorGroups.colorizeTabs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also color the titles of the real editor tabs (and the file's label in other views) with the project color, using file decorations. Requires `#workbench.editor.decorations.colors#` to be enabled. Source control and problem decorations keep precedence for files that have them."
        },
        "openEditorGroups.projectColorOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "default": {},
          "markdownDescription": "Pins a project name to a palette slot (1-12), for example `{ \"Contoso.Server\": 3 }`. Edit with the **Set Project Color...** context menu command. The slot colors themselves are theme colors named `openEditorGroups.projectColor1` ... `openEditorGroups.projectColor12` and can be changed in `#workbench.colorCustomizations#`."
        }
      }
    },
    "colors": [
      { "id": "openEditorGroups.projectColor1", "description": "Project color slot 1 (blue).", "defaults": { "dark": "#4FA3FF", "light": "#0B6BCB", "highContrast": "#4FA3FF", "highContrastLight": "#0B6BCB" } },
      { "id": "openEditorGroups.projectColor2", "description": "Project color slot 2 (purple).", "defaults": { "dark": "#B180D7", "light": "#7B3FBF", "highContrast": "#B180D7", "highContrastLight": "#7B3FBF" } },
      { "id": "openEditorGroups.projectColor3", "description": "Project color slot 3 (teal).", "defaults": { "dark": "#4EC9B0", "light": "#0F8A6E", "highContrast": "#4EC9B0", "highContrastLight": "#0F8A6E" } },
      { "id": "openEditorGroups.projectColor4", "description": "Project color slot 4 (gold).", "defaults": { "dark": "#E2C08D", "light": "#A66E00", "highContrast": "#E2C08D", "highContrastLight": "#A66E00" } },
      { "id": "openEditorGroups.projectColor5", "description": "Project color slot 5 (orange).", "defaults": { "dark": "#F0883E", "light": "#C4520A", "highContrast": "#F0883E", "highContrastLight": "#C4520A" } },
      { "id": "openEditorGroups.projectColor6", "description": "Project color slot 6 (red).", "defaults": { "dark": "#F14C4C", "light": "#C42B1C", "highContrast": "#F14C4C", "highContrastLight": "#C42B1C" } },
      { "id": "openEditorGroups.projectColor7", "description": "Project color slot 7 (pink).", "defaults": { "dark": "#E37EB8", "light": "#B3266F", "highContrast": "#E37EB8", "highContrastLight": "#B3266F" } },
      { "id": "openEditorGroups.projectColor8", "description": "Project color slot 8 (cyan).", "defaults": { "dark": "#3AC9E8", "light": "#007A99", "highContrast": "#3AC9E8", "highContrastLight": "#007A99" } },
      { "id": "openEditorGroups.projectColor9", "description": "Project color slot 9 (green).", "defaults": { "dark": "#89D185", "light": "#2E8B2E", "highContrast": "#89D185", "highContrastLight": "#2E8B2E" } },
      { "id": "openEditorGroups.projectColor10", "description": "Project color slot 10 (indigo).", "defaults": { "dark": "#8A8FE8", "light": "#4A4FBF", "highContrast": "#8A8FE8", "highContrastLight": "#4A4FBF" } },
      { "id": "openEditorGroups.projectColor11", "description": "Project color slot 11 (brown).", "defaults": { "dark": "#C69C6D", "light": "#7D5A33", "highContrast": "#C69C6D", "highContrastLight": "#7D5A33" } },
      { "id": "openEditorGroups.projectColor12", "description": "Project color slot 12 (gray).", "defaults": { "dark": "#9DA5B4", "light": "#6B7280", "highContrast": "#9DA5B4", "highContrastLight": "#6B7280" } },
      { "id": "openEditorGroups.unassignedColor", "description": "Bar color for editors that do not belong to a project (Untitled, External, Other).", "defaults": { "dark": "#6E7681", "light": "#8C8C8C", "highContrast": "#9DA5B4", "highContrastLight": "#6B7280" } }
    ],
    "icons": {
      "open-editor-groups-bar": {
        "description": "Vertical project color bar shown in front of open editors.",
        "default": {
          "fontPath": "./resources/icons/open-editor-groups.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "build:icons": "python scripts/build-icon-font.py",
    "vsix": "vsce package",
    "vsix:local": "vsce package --allow-missing-repository --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
